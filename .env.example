# Neon connectiestring
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/startlijst?sslmode=require"

# openssl rand -base64 32
AUTH_SECRET=""

# Zonder dit werken de magic links niet
RESEND_API_KEY=""
EMAIL_FROM="Ultimate Challenges <hallo@jouwdomein.nl>"

# Volledige URL zonder slash op het eind. Gebruikt in de ICS-feed en de OG-kaartjes.
NEXT_PUBLIC_SITE_URL="https://startlijst.vercel.app"

# Wie mag inloggen. Leeg laten betekent: iedereen die de URL kent.
ALLOWED_EMAILS="maurice@voorbeeld.nl,bert@voorbeeld.nl"

# De super-admin (mag admins toevoegen/verwijderen). Zet dit op jouw eigen adres.
# Leeg laten = geen super-admin, dan is de adminpagina voor niemand te bereiken.
SUPER_ADMIN_EMAIL="jij@voorbeeld.nl"

# Gratis Google Gemini key voor de AI-import (aistudio.google.com/apikey).
# Leeg laten schakelt de "importeer via link"-knop uit.
GEMINI_API_KEY=""
# Optioneel: sneller model voor trainingsplannen (standaard gemini-3.5-flash-lite).
# Bijvoorbeeld gemini-3.6-flash voor een zwaarder model.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Notion OAuth: publieke verbinding voor de eigen workspaces van je vriendengroep.
# Marketplace-publicatie is niet nodig voor de app-code.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
# Exact dezelfde callback-URL invullen in het Notion Developer portal.
NOTION_REDIRECT_URI=""
# Eenmalig genereren: openssl rand -base64 32. Bewaar deze sleutel bij je database.
NOTION_TOKEN_ENCRYPTION_KEY=""
